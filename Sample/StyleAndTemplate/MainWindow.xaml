<Window x:Class="StyleAndTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StyleAndTemplate"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <UniformGrid Columns="3">
        <Grid>
            <Grid Height="50"
                  Width="50"
                  Style="{StaticResource YellowGrid}" />
        </Grid>

        <Grid>
            <Grid Height="50"
                  Width="50"
                  Background="{DynamicResource MyButtonBrush}" 
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,0,60"/>
            <Button Content="点击"
                    Click="Button_Click"
                    Height="30"
                    Width="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
        </Grid>

    </UniformGrid>
</Window>
