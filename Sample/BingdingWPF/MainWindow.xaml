<Window x:Class="BingdingWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingdingWPF"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid>
        <TextBlock Text="{Binding TestValue}"
                   FontSize="20"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

        <Button Width="100"
                Height="30"
                Content="事件"
                Command="{Binding EventCommand}" 
                Margin="0,100,0,0"/>

        <Button Width="100"
                Height="30"
                Content="事件"
                Command="{Binding SbCommand}"
                Margin="0,10,0,0" />
    </Grid>
</Window>
